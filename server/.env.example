# Copy this file to `.env` and fill in the values.

# Neon pooled connection string (for the app)
DATABASE_URL=

# Neon direct connection string (for Prisma CLI migrations)
DIRECT_URL=

PORT=3030

# OpenAI API key for AI lead analysis (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Shared secret used to authorize the internal analysis callback
INTERNAL_API_KEY=

# Allowed frontend origin (CORS)
FRONTEND_URL=http://localhost:3000

# Resend API key for outreach email sending (https://resend.com)
RESEND_API_KEY=

# Sender address (Resend sandbox: onboarding@resend.dev until a domain is verified)
EMAIL_FROM=onboarding@resend.dev

# Optional test-mode override: if set, all sends go to this address (no domain needed)
EMAIL_TEST_TO=

# Google Sheets sync (optional - app works without these)
# Spreadsheet ID from the sheet URL: /spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account JSON key (one line). Share the sheet with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
